+ */
+
+#include <glib.h>
+
+#include "fp-print-private.h"
+#include "fpi-device.h"
+#include "fpi-image.h"
+#include "fpi-minutiae.h"
+#include "fpi-print.h"
+
+typedef struct
+{
+  guint    minutiae_count;
+  gboolean accepted;
+} AddFromImageCase;
+
+/* The interesting values are the ones around
+ * MIN_COMPUTABLE_BOZORTH_MINUTIAE: nothing at all, a single minutia, one
+ * below the minimum, and exactly the minimum. */
+static const AddFromImageCase add_from_image_cases[] = {
+  { 0, FALSE },
+  { 1, FALSE },
+  { MIN_COMPUTABLE_BOZORTH_MINUTIAE - 1, FALSE },
+  { MIN_COMPUTABLE_BOZORTH_MINUTIAE, TRUE },
+};
+
+static FpImage *
+make_image_with_minutiae (guint minutiae_count)
+{
+  FpImage *image;
+  guint i;
+
+  image = fp_image_new (128, 128);
+  image->minutiae = g_ptr_array_new_with_free_func ((GDestroyNotify) free_minutia);
+
+  for (i = 0; i < minutiae_count; i++)
+    {
+      struct fp_minutia *minutia = g_new0 (struct fp_minutia, 1);
+
+      minutia->x = 10 + i * 3;
+      minutia->y = 20 + i * 4;
+      minutia->direction = i % 16;
+      minutia->reliability = 0.95;
+      g_ptr_array_add (image->minutiae, minutia);
+    }
+
+  return image;
+}
+
+static FpPrint *
+make_nbis_print (void)
+{
+  FpPrint *print;
+
+  print = g_object_new (FP_TYPE_PRINT,
+                        "driver", "unit-test",
+                        "device-id", "unit-test-device",
+                        NULL);
+  fpi_print_set_type (print, FPI_PRINT_NBIS);
+
+  return g_object_ref_sink (print);
+}
+
+static void
+test_add_from_image_minimum (gconstpointer user_data)
+{
+  const AddFromImageCase *test_case = user_data;
+
+  g_autoptr(FpImage) image = NULL;
+  g_autoptr(FpPrint) print = NULL;
+  g_autoptr(GError) error = NULL;
+  gboolean accepted;
+
+  image = make_image_with_minutiae (test_case->minutiae_count);
+  print = make_nbis_print ();
+  accepted = fpi_print_add_from_image (print, image, &error);
+
+  g_assert_cmpint (accepted, ==, test_case->accepted);
+
+  if (!test_case->accepted)
+    {
+      /* A retryable error keeps the enrolment session alive, so the caller
+       * asks for the same stage again instead of storing a print that can
+       * never match. */
+      g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+      g_assert_cmpuint (print->prints->len, ==, 0);
+      g_assert_null (fp_print_get_image (print));
+      return;
+    }
+
+  g_assert_no_error (error);
+  g_assert_cmpuint (print->prints->len, ==, 1);
+  g_assert_cmpint (((struct xyt_struct *) print->prints->pdata[0])->nrows,
+                   ==, test_case->minutiae_count);
+  g_assert_true (fp_print_get_image (print) == image);
+}
+
+int
+main (int argc, char *argv[])
+{
+  guint i;
+
+  g_test_init (&argc, &argv, NULL);
+
+  for (i = 0; i < G_N_ELEMENTS (add_from_image_cases); i++)
+    {
+      g_autofree gchar *test_name = NULL;
+
+      test_name = g_strdup_printf ("/fpi-print/add-from-image/%u-minutiae",
+                                   add_from_image_cases[i].minutiae_count);
+      g_test_add_data_func (test_name, &add_from_image_cases[i],
+                            test_add_from_image_minimum);
+    }
+
+  return g_test_run ();
+}
