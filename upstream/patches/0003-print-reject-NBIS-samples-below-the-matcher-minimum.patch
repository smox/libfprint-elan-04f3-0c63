From e71c370ac5acf86c18e153a09187dde01aa59d16 Mon Sep 17 00:00:00 2001
From: Michael Brunner <michael.brunner@sm0x.org>
Date: Thu, 20 Aug 2026 13:18:47 +0200
Subject: [PATCH 3/3] print: reject NBIS samples below the matcher minimum

fpi_print_add_from_image() accepts any non-empty minutiae list.  Bozorth
however returns ZERO_MATCH_SCORE as soon as either side holds fewer than
MIN_COMPUTABLE_BOZORTH_MINUTIAE entries, currently ten:

    bozorth3.c:642  if (pstruct->nrows < MIN_COMPUTABLE_BOZORTH_MINUTIAE)
    bozorth3.c:663  if (gstruct->nrows < MIN_COMPUTABLE_BOZORTH_MINUTIAE)

Enrolment can therefore complete successfully while storing a print that
is mathematically unable to ever match.  The user sees "enroll-completed"
and every later verification fails with no-match, which looks like a
recognition problem rather than a rejected sample.

This was reproduced on an ELAN 04f3:0c63.  A controlled enrolment stored
five stages holding 6, 7, 8, 3 and 6 XYT rows.  All ten pairwise
comparisons within that gallery, and every comparison against later
probes, scored zero - including probes with 14 and 17 minutiae, because
the gallery side alone already falls below the minimum.

Enforce the matcher's own precondition before the sample enters a
gallery.  The minimum is derived from the existing NBIS constant rather
than duplicated, so it stays correct if NBIS changes.  The error uses the
FP_DEVICE_RETRY domain, so image devices keep the session alive and ask
for the same stage again instead of aborting: fpi_image_device_* only
advances the stage counter when a print was actually returned.

The same guard makes an undersized verification probe report a retryable
scan error rather than a misleading final no-match.

Capture, non-NBIS devices and all matching thresholds are unaffected.

Tests cover 0, 1, MIN-1 and MIN minutiae and assert that a rejected
sample leaves both the print gallery and the retained image untouched.

Co-authored-by: Claude Opus 5 <noreply@anthropic.com>
---
 libfprint/fpi-print.c  |  21 +++++--
 tests/meson.build      |   1 +
 tests/test-fpi-print.c | 133 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 149 insertions(+), 6 deletions(-)
 create mode 100644 tests/test-fpi-print.c

diff --git a/libfprint/fpi-print.c b/libfprint/fpi-print.c
index 6c5e20d..3416c33 100644
--- a/libfprint/fpi-print.c
+++ b/libfprint/fpi-print.c
@@ -173,6 +173,7 @@ fpi_print_add_from_image (FpPrint *print,
                           GError **error)
 {
   GPtrArray *minutiae;
+  guint minutiae_count;
   struct fp_minutiae _minutiae;
   struct xyt_struct *xyt;
 
@@ -186,18 +187,26 @@ fpi_print_add_from_image (FpPrint *print,
     }
 
   minutiae = fp_image_get_minutiae (image);
-  if (!minutiae || minutiae->len == 0)
+  minutiae_count = minutiae ? minutiae->len : 0;
+
+  /* Bozorth cannot produce a score unless both sides carry at least
+   * MIN_COMPUTABLE_BOZORTH_MINUTIAE entries.  Accepting anything below that
+   * during enrolment stores a print that can only ever match with score
+   * zero, so reject it as a retryable scan error instead. */
+  if (minutiae_count < MIN_COMPUTABLE_BOZORTH_MINUTIAE)
     {
       g_set_error (error,
-                   G_IO_ERROR,
-                   G_IO_ERROR_INVALID_DATA,
-                   "No minutiae found in image or not yet detected!");
+                   FP_DEVICE_RETRY,
+                   FP_DEVICE_RETRY_GENERAL,
+                   "Only %u minutiae found, at least %u are required to match",
+                   minutiae_count,
+                   (guint) MIN_COMPUTABLE_BOZORTH_MINUTIAE);
       return FALSE;
     }
 
-  _minutiae.num = minutiae->len;
+  _minutiae.num = minutiae_count;
   _minutiae.list = (struct fp_minutia **) minutiae->pdata;
-  _minutiae.alloc = minutiae->len;
+  _minutiae.alloc = minutiae_count;
 
   xyt = g_new0 (struct xyt_struct, 1);
   minutiae_to_xyt (&_minutiae, image->width, image->height, xyt);
diff --git a/tests/meson.build b/tests/meson.build
index aad0675..f360668 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -312,6 +312,7 @@ unit_tests = [
     'fpi-device',
     'fpi-ssm',
     'fpi-assembling',
+    'fpi-print',
 ]
 
 if 'virtual_image' in drivers
diff --git a/tests/test-fpi-print.c b/tests/test-fpi-print.c
new file mode 100644
index 0000000..7315844
--- /dev/null
+++ b/tests/test-fpi-print.c
@@ -0,0 +1,133 @@
