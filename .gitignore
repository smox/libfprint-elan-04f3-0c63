# Biometric data must never leave this directory as part of a repository.
# The raw corpus deliberately lives outside the project under
# /var/lib/fprint-research/ (root-exclusive, 0700), and capture_corpus.py
# refuses to write into any git repository. These rules are a second line of
# defence.

# Raw captures, frames, templates
*.raw
*.frame
*.frames
*.pgm
*.pnm
*.xyt
*.tmpl
*.template
*.npz
fprint-corpus/
raw-captures/
test-root/

# Journals can carry device detail
*.log

# Build artefacts
build/
rpm/
build-rpms/
build-rpms-openssl/
*.rpm
build-deb/
deb/
*.deb
*.ddeb
*.buildinfo
*.changes
*.dsc
*.o
*.so
*.tar.bz2
*.tar.gz

# osc working directories
.osc/

# Python working environment
tools/.venv/
__pycache__/
*.pyc
